-#define UFS_ADT_NODE            "/dreamlte-ufs"
+#define UFS_ADT_NODE            "/a51-ufs"
-#define UFS_DEFAULT_PART        "USERDATA"
+#define UFS_DEFAULT_PART        "userdata"
 #define PRDT_BYTES(field)       (field)
 #else
 #define UFS_ADT_NODE            "/sweet-ufs"
