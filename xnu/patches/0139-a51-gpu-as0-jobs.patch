+static void
+a51_zero(vm_offset_t va, size_t bytes)
+{
+	volatile uint64_t *q = (volatile uint64_t *)va;
+	for (size_t i = 0; i < bytes / 8; i++) {
+		q[i] = 0;
+	}
+}
+
+static volatile uint64_t *
+a51_table(uint32_t off)
+{
+	return (volatile uint64_t *)(a51_region + off);
+}
+
+/* Four levels (L0..L3): test pages and scratch under the low L2, the user
+ * range under its own L2 with every L3 table present (empty). */
+static void
+a51_gpu_tables(void)
+{
+	a51_zero(a51_region, R_L3_USER + 512 * 0x1000);
+	a51_table(R_L0)[a51_pt_index(0, 0)] = a51_pte_table(A51_REGION_PA + R_L1);
+	a51_table(R_L1)[a51_pt_index(0, 1)] = a51_pte_table(A51_REGION_PA + R_L2_LOW);
+	a51_table(R_L1)[a51_pt_index(A51_USER_VA, 1)] = a51_pte_table(A51_REGION_PA + R_L2_USER);
+	a51_table(R_L2_LOW)[a51_pt_index(A51_TEST_VA, 2)] = a51_pte_table(A51_REGION_PA + R_L3_TEST);
+	a51_table(R_L2_LOW)[a51_pt_index(A51_SCRATCH_VA, 2)] = a51_pte_table(A51_REGION_PA + R_L3_SCRATCH);
+	for (unsigned i = 0; i < R_TEST_PAGES; i++) {
+		a51_table(R_L3_TEST)[i] = a51_pte_page(A51_REGION_PA + R_TEST + i * 0x1000ull);
+	}
+	for (unsigned i = 0; i < 512; i++) {
+		a51_table(R_L3_SCRATCH)[i] = a51_pte_page(A51_REGION_PA + R_SCRATCH + i * 0x1000ull);
+		a51_table(R_L2_USER)[i] = a51_pte_table(A51_REGION_PA + R_L3_USER + i * 0x1000ull);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	a51_as_ok = false;
+}
+
+static bool
+a51_as_idle(void)
+{
+	for (unsigned i = 0; i < 10000; i++) {
+		if (!(a51_gpu_rd(AS0 + AS_STATUS) & 1)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/* Lock a VA range and flush the MMU's page-table caches for it (kbase's
+ * mmu_hw_do_operation): LOCKADDR, LOCK, FLUSH_PT, each waited for. */
+static bool
+a51_mmu_flush(uint64_t va, unsigned log2_size)
+{
+	uint64_t lock = (va & ~((1ull << log2_size) - 1)) | (log2_size - 1);
+	if (!a51_as_idle()) {
+		return false;
+	}
+	a51_gpu_wr(AS0 + AS_LOCKADDR_LO, (uint32_t)lock);
+	a51_gpu_wr(AS0 + AS_LOCKADDR_HI, (uint32_t)(lock >> 32));
+	a51_gpu_wr(AS0 + AS_COMMAND, AS_COMMAND_LOCK);
+	if (!a51_as_idle()) {
+		return false;
+	}
+	a51_gpu_wr(AS0 + AS_COMMAND, AS_COMMAND_FLUSH_PT);
+	return a51_as_idle();
+}
+
+/* Hard-stop whatever is still on a slot (as kbase does); if a slot stays
+ * active, soft-reset the GPU and power it again. AS0 is reprogrammed by the
+ * next job. Without this one fault blocks every later job (S7 0249). */
+static void
+a51_gpu_recover(const char *what)
+{
+	static unsigned resets;
+	for (unsigned js = 0; js < 2; js++) {
+		if ((a51_gpu_rd(JS_BASE(js) + JS_STATUS) & 0xff) == JS_STATUS_ACTIVE) {
+			a51_gpu_wr(JS_BASE(js) + JS_COMMAND, JS_COMMAND_HARD_STOP);
+			for (unsigned i = 0; i < 1000 &&
+			    (a51_gpu_rd(JS_BASE(js) + JS_STATUS) & 0xff) == JS_STATUS_ACTIVE; i++) {
+				delay(10);
+			}
+		}
+	}
+	a51_gpu_wr(JOB_IRQ_CLEAR, 0xffffffffu);
+	a51_gpu_wr(MMU_IRQ_CLEAR, 0xffffffffu);
+	a51_as_ok = false;
+	if ((a51_gpu_rd(JS_BASE(0) + JS_STATUS) & 0xff) != JS_STATUS_ACTIVE &&
+	    (a51_gpu_rd(JS_BASE(1) + JS_STATUS) & 0xff) != JS_STATUS_ACTIVE) {
+		return;
+	}
+	bool done = a51_gpu_soft_reset();
+	bool up = a51_gpu_cores_on();
+	printf("A51 GPU: %s: soft reset #%u (%s), cores %s\n", what, ++resets,
+	    done ? "done" : "timed out", up ? "back up" : "NOT up");
+}
+
+/* Start the job chain at GPU VA jc on slot js on all shader cores and wait
+ * (bounded). True when it finished cleanly; otherwise logged and recovered. */
+static bool
+a51_gpu_run(unsigned js, uint64_t jc, const char *what)
+{
+	uint32_t slot = JS_BASE(js);
+	uint64_t start = mach_absolute_time(), ns;
+	a51_gpu_wr(MMU_IRQ_CLEAR, 0xffffffffu);
+	a51_gpu_wr(JOB_IRQ_CLEAR, 0xffffffffu);
+	if (!a51_as_ok) {
+		uint64_t transtab = A51_REGION_PA + R_L0 + A51_TRANSTAB_FLAGS;
+		a51_gpu_wr(AS0 + AS_TRANSTAB_LO, (uint32_t)transtab);
+		a51_gpu_wr(AS0 + AS_TRANSTAB_HI, (uint32_t)(transtab >> 32));
+		a51_gpu_wr(AS0 + AS_MEMATTR_LO, A51_MEMATTR);
+		a51_gpu_wr(AS0 + AS_MEMATTR_HI, 0);
+		a51_gpu_wr(AS0 + AS_COMMAND, AS_COMMAND_UPDATE);
+		if (!a51_as_idle()) {
+			printf("A51 GPU: %s: MMU update timeout\n", what);
+			return false;
+		}
+		a51_as_ok = true;
+	}
+	/* Client chains are written through write-combined mappings. */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	a51_gpu_wr(slot + JS_HEAD_NEXT_LO, (uint32_t)jc);
+	a51_gpu_wr(slot + JS_HEAD_NEXT_HI, (uint32_t)(jc >> 32));
+	a51_gpu_wr(slot + JS_AFFINITY_NEXT_LO, a51_gpu_rd(SHADER_PRESENT_LO));
+	a51_gpu_wr(slot + JS_AFFINITY_NEXT_HI, 0);
+	a51_gpu_wr(slot + JS_CONFIG_NEXT, A51_JS_CONFIG);
+	a51_gpu_wr(slot + JS_COMMAND_NEXT, JS_COMMAND_START);
+
+	uint32_t jirq = 0, mirq = 0, girq = 0;
+	for (unsigned i = 0; i < 20000; i++) {         /* 200 ms */
+		jirq = a51_gpu_rd(JOB_IRQ_RAWSTAT);
+		mirq = a51_gpu_rd(MMU_IRQ_RAWSTAT);
+		girq = a51_gpu_rd(GPU_IRQ_RAWSTAT);
+		if ((jirq & ((1u << js) | (1u << (js + 16)))) || mirq || (girq & 0x81)) {
+			break;
+		}
+		delay(10);
+	}
+	bool ok = (jirq & (1u << js)) && !(jirq & (1u << (js + 16))) && !mirq && !(girq & 0x81);
+	a51_last_js_status = a51_gpu_rd(slot + JS_STATUS);
+	absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+	if (!ok || a51_gpu_log) {
+		printf("A51 GPU: job js %u status %#x %llu us (%s) irq %#x mmu %#x gpu %#x "
+		    "head %#x%08x as_fault %#x@%#x gpu_fault %#x@%#x\n", js, a51_last_js_status,
+		    ns / 1000, what, jirq, mirq, girq, a51_gpu_rd(slot + JS_HEAD_HI),
+		    a51_gpu_rd(slot + JS_HEAD_LO), a51_gpu_rd(AS0 + AS_FAULTSTATUS),
+		    a51_gpu_rd(AS0 + AS_FAULTADDRESS_LO), a51_gpu_rd(GPU_FAULTSTATUS),
+		    a51_gpu_rd(GPU_FAULTADDR_LO));
+	}
+	a51_gpu_wr(JOB_IRQ_CLEAR, 0xffffffffu);
+	a51_gpu_wr(MMU_IRQ_CLEAR, 0xffffffffu);
+	if (!ok) {
+		a51_gpu_recover(what);
+	}
+	return ok;
+}
+
+/* Power, reset, map the region, build the tables. Called with the mutex. */
+static bool
+a51_gpu_bringup(void)
+{
+	if (a51_gpu_state != 0) {
+		return a51_gpu_state == 1;
+	}
+	a51_gpu_state = -1;
+	if (!a51_pmu || !a51_gpu_powered()) {
+		printf("A51 GPU: bring-up: G3D off\n");
+		return false;
+	}
+	if (!a51_gpu_base) {
+		a51_gpu_base = ml_io_map(A51_GPU_PA, A51_GPU_BYTES);
+	}
+	a51_region = ml_io_map((vm_offset_t)A51_REGION_PA, A51_REGION_MAPPED);
+	if (!a51_gpu_base || !a51_region) {
+		printf("A51 GPU: bring-up: mapping failed\n");
+		return false;
+	}
+	if (!a51_gpu_soft_reset() || !a51_gpu_cores_on()) {
+		return false;
+	}
+	a51_gpu_tables();
+	a51_gpu_state = 1;
+	printf("A51 GPU: ready shader %#x tiler %#x l2 %#x, user VA %#llx..%#llx\n",
+	    a51_gpu_rd(SHADER_READY_LO), a51_gpu_rd(TILER_READY_LO), a51_gpu_rd(L2_READY_LO),
+	    A51_USER_VA, A51_USER_VA + A51_USER_BYTES);
+	return true;
+}
+
+/* A job at an unmapped VA (recovery), then WRITE_VALUE zeroing 64 bits of
+ * a test page (the job HeroGPU first ran on the T880). */
+static void
+a51_gpu_boot_jobs(void)
+{
+	lck_mtx_lock(a51_gpu_mtx);
+	if (a51_gpu_state == 1) {
+		bool bad = a51_gpu_run(1, 0x7ff00000ull, "unmapped chain");
+		printf("A51 GPU: bad job js 1 status %#x %s\n", a51_last_js_status,
+		    bad ? "UNEXPECTEDLY OK" : "recovered");
+		vm_offset_t test = a51_region + R_TEST;
+		a51_zero(test, R_TEST_PAGES * 0x1000);
+		volatile uint8_t *job = (volatile uint8_t *)test;
+		job[16] = 1 | (2 << 1);                         /* 64-bit, WRITE_VALUE */
+		*(volatile uint16_t *)(job + 18) = 1;           /* index */
+		*(volatile uint64_t *)(job + 32) = A51_TEST_VA + A51_OUT_OFF;
+		*(volatile uint64_t *)(job + 40) = 3;           /* zero 64 bits */
+		volatile uint64_t *out = (volatile uint64_t *)(test + A51_OUT_OFF);
+		*out = 0xa5a5a5a55a5a5a5aull;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		uint64_t start = mach_absolute_time(), ns;
+		bool ok = a51_gpu_run(1, A51_TEST_VA, "WRITE_VALUE") && *out == 0;
+		absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+		printf("A51 GPU: write_value %s %#llx in %llu us\n", ok ? "ok" : "FAILED",
+		    *out, ns / 1000);
+	}
+	lck_mtx_unlock(a51_gpu_mtx);
+}
+
+bool
+herolte_gpu_up(void)
+{
+	lck_mtx_lock(a51_gpu_mtx);
+	bool ok = a51_gpu_bringup();
+	lck_mtx_unlock(a51_gpu_mtx);
+	return ok;
+}
+
+/* A GPU register (GPU_ID, *_PRESENT, *_FEATURES...), for GetParam. */
+uint32_t
+herolte_gpu_reg(uint32_t off)
+{
+	if (a51_gpu_state != 1 || off >= 0x1000 || (off & 3)) {
+		return 0;
+	}
+	return a51_gpu_rd(off);
+}
+
+uint64_t
+herolte_gpu_va_alloc(uint64_t bytes)
+{
+	lck_mtx_lock(a51_gpu_mtx);
+	uint64_t va = a51_gpu_state == 1 ? a51_va_alloc(&a51_va, bytes) : 0;
+	lck_mtx_unlock(a51_gpu_mtx);
+	return va;
+}
+
+/* PTEs for n 4 KiB pages at va (pages == NULL: unmap), then an MMU flush. */
+static bool
+a51_user_set_locked(uint64_t va, const uint64_t *pages, unsigned n)
+{
+	for (unsigned i = 0; i < n; i++) {
+		uint64_t a = va + (uint64_t)i * 0x1000;
+		if (a < A51_USER_VA || a >= A51_USER_VA + A51_USER_BYTES) {
+			return false;
+		}
+		volatile uint64_t *l3 = a51_table(R_L3_USER + a51_pt_index(a, 2) * 0x1000u);
+		l3[a51_pt_index(a, 3)] = pages ? a51_pte_page(pages[i]) : 0;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return a51_mmu_flush(A51_USER_VA, 30);
+}
+
+bool
+herolte_gpu_map(uint64_t va, const uint64_t *pages, unsigned n)
+{
+	lck_mtx_lock(a51_gpu_mtx);
+	bool ok = a51_gpu_state == 1 && a51_user_set_locked(va, pages, n);
+	lck_mtx_unlock(a51_gpu_mtx);
+	return ok;
+}
+
+void
+herolte_gpu_unmap(uint64_t va, unsigned n)
+{
+	lck_mtx_lock(a51_gpu_mtx);
+	if (a51_gpu_state == 1) {
+		(void)a51_user_set_locked(va, NULL, n);
+		a51_va_free(&a51_va, va, (uint64_t)n * 0x1000);
+	}
+	lck_mtx_unlock(a51_gpu_mtx);
+}
+
+/* Run the chain at GPU VA jc on slot js (0 fragment, 1 the rest). Returns 0
+ * when it finished cleanly, else JS_STATUS (~0 if it never ran); *us = time. */
+uint32_t
+herolte_gpu_submit(unsigned js, uint64_t jc, uint64_t *us)
+{
+	if (js > 1 || jc == 0) {
+		return ~0u;
+	}
+	lck_mtx_lock(a51_gpu_mtx);
+	uint32_t status = ~0u;
+	if (a51_gpu_state == 1) {
+		uint64_t start = mach_absolute_time(), ns;
+		bool ok = a51_gpu_run(js, jc, js ? "HeroGPU JS1" : "HeroGPU JS0");
+		status = ok ? 0 : (a51_last_js_status ? a51_last_js_status : ~0u);
+		absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+		if (us) {
+			*us = ns / 1000;
+		}
+	}
+	lck_mtx_unlock(a51_gpu_mtx);
+	return status;
+}
