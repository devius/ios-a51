SweetFramebuffer: swaps/s and presents/s once a second (a51fps=1).

For the GPU-UI before/after measurement: backboardd's swaps per second (its
render rate) and the panel copies per second (what the screen shows, capped
by sweetfb_hz). The existing log has only the first 16 swaps and every
1000th.

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 9cc2a29..4d2096c 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -402,6 +402,37 @@ int sweet_fb_ios_display_off;   /* iOS's last RequestPowerChange: 1 = off */
 static uint32_t sweet_fb_swaps_logged;
 static uint64_t sweet_fb_swap_count;
 
+/*
+ * Boot-arg a51fps=1 (A51 GPU sub-project 3): once a second, the frames
+ * backboardd swapped (its render rate) and the panel copies made (what the
+ * screen shows, capped by sweetfb_hz), for before/after measurements.
+ */
+static int sweet_fb_fps = -1;
+static uint32_t sweet_fb_sec_swaps, sweet_fb_sec_presents;
+static uint64_t sweet_fb_sec_start;
+
+static void
+sweet_fb_fps_tick(uint64_t now)
+{
+	if (sweet_fb_fps < 0) {
+		sweet_fb_fps = 0;
+		PE_parse_boot_argn("a51fps", &sweet_fb_fps, sizeof(sweet_fb_fps));
+	}
+	if (!sweet_fb_fps) {
+		return;
+	}
+	uint64_t ns;
+	absolutetime_to_nanoseconds(now - sweet_fb_sec_start, &ns);
+	if (ns >= NSEC_PER_SEC) {
+		if (sweet_fb_sec_start != 0) {
+			IOLog("SWEET FB: %u swaps/s, %u presents/s\n", sweet_fb_sec_swaps, sweet_fb_sec_presents);
+		}
+		sweet_fb_sec_start = now;
+		sweet_fb_sec_swaps = 0;
+		sweet_fb_sec_presents = 0;
+	}
+}
+
 /* Copy each enabled layer's surface into the panel memory (no scaling). */
 /*
  * A swap only records the frame: copying 10 MB into the panel on every
@@ -428,11 +459,14 @@ AppleCLCD::swap(const uint8_t *rec)
 	if ((++sweet_fb_swap_count % 1000) == 0) {
 		IOLog("SWEET FB: %llu swaps\n", sweet_fb_swap_count);
 	}
+	sweet_fb_sec_swaps++;
+	sweet_fb_fps_tick(now);
 }
 
 void
 AppleCLCD::present(const uint8_t *rec)
 {
+	sweet_fb_sec_presents++;
 	uint32_t mask = get32(rec, 0x104);
 	IOLockLock(fPresentLock);
 #if (defined(DREAMLTE) || defined(A51))
